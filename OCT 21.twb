      <column caption='Borough (taxi zone lookup.csv1)' datatype='string' name='[Borough (taxi_zone_lookup.csv1)]' role='dimension' type='nominal' />
      <column caption='Top 5' datatype='real' name='[Calculation_0378841058181124]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 0378841056735235]&#13;&#10;WHEN &quot;Average Revenue&quot; THEN AVG([total_amount])&#13;&#10;WHEN &quot;Average Tip Amount&quot; THEN AVG([tip_amount])&#13;&#10;END' />
      </column>
      <column caption='Trip time' datatype='integer' name='[Calculation_0497587962712065]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEDIFF(&apos;minute&apos;, [lpep_pickup_datetime], [lpep_dropoff_datetime])' />
      </column>
      <column caption='Time of day' datatype='string' name='[Calculation_0497587971727363]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF  DATEPART(&apos;hour&apos;, [lpep_pickup_datetime])&gt;= 4 AND DATEPART(&apos;hour&apos;, [lpep_pickup_datetime])&lt;=10 THEN&quot;MORNING&quot;&#13;&#10;ELSEIF DATEPART(&apos;hour&apos;, [lpep_pickup_datetime])&gt;= 11 AND DATEPART(&apos;hour&apos;, [lpep_pickup_datetime])&lt;=16 THEN&quot;AFTERNOON&quot;&#13;&#10;ELSEIF DATEPART(&apos;hour&apos;, [lpep_pickup_datetime])&gt;= 17 AND DATEPART(&apos;hour&apos;, [lpep_pickup_datetime])&lt;=21 THEN&quot;EVENING&quot;&#13;&#10;ELSE &quot;LATENIGHT&quot;&#13;&#10;END' />
      </column>
